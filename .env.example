# Copy these into Netlify → Site configuration → Environment variables.
# Never commit real values. Local overrides go in .env.local (git-ignored).

# --- Admin panel login ---------------------------------------------------
# Generate with:  npm run admin:hash -- "your long password"
ADMIN_PASSWORD_HASH=
# Any random string of 32+ characters (signs the admin session cookie)
SESSION_SECRET=

# --- New-order notifications (Telegram) ----------------------------------
# Create a bot with @BotFather, send it a message, then read the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Publishing catalog changes ------------------------------------------
# Netlify → Site configuration → Build & deploy → Build hooks → Add build hook
BUILD_HOOK_URL=

# --- Payments -------------------------------------------------------------
# Leave off until a card gateway contract exists and its integration is deployed.
# CARD_PAYMENTS=on

# --- Storage ---------------------------------------------------------------
# Name of the Netlify Blobs store. Leave unset in production (defaults to "belvency").
# Use a different name (e.g. belvency-test) while testing so test orders never mix with real ones.
# STORE_NAME=
